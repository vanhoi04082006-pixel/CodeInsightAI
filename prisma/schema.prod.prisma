// CodeInsight AI — Prisma schema (PRODUCTION — PostgreSQL on Neon)
//
// Used by the Vercel build via the PRISMA_SCHEMA env var:
//   PRISMA_SCHEMA=prisma/schema.prod.prisma
//
// Identical model definitions to prisma/schema.prisma — only the datasource
// provider differs (postgresql vs sqlite). KEEP IN SYNC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & AUTH (NextAuth.js)
// ==========================================

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  // SaaS fields
  plan            String    @default("free") // free | pro | team | enterprise
  role            String    @default("user") // user | admin
  banned          Boolean   @default(false)
  stripeCustomerId String?
  trialEndsAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  analyses        Analysis[]
  credentials     ProviderCredential[]
  usageRecords    UsageRecord[]
  tokenUsageRecords TokenUsageRecord[]
  rateLimitBuckets  RateLimitBucket[]
  settings        UserSettings[]
  auditLogs       AuditLog[]
  aiCallLogs      AICallLog[]
  shareTokens     ShareToken[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// ANALYSIS & CHAT (multi-tenant via userId)
// ==========================================

model Analysis {
  id                 String   @id @default(cuid())
  userId             String?
  repoUrl            String
  repoOwner          String
  repoName           String
  repoBranch         String   @default("main")
  status             String   @default("completed")

  overallScore       Int      @default(0)
  securityScore      Int      @default(0)
  performanceScore   Int      @default(0)
  architectureScore  Int      @default(0)
  maintainabilityScore Int    @default(0)
  codeQualityScore   Int      @default(0)

  primaryLanguage    String?
  totalFiles         Int      @default(0)
  totalLines         Int      @default(0)
  languages          String   @default("[]")
  frameworks         String   @default("[]")
  report             String   @default("{}")
  parsedData         String?
  aiStatus           String   @default("none") // none | pending | done | failed

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           ChatMessage[]
  fileSummaries      FileSummary[]
  shareTokens        ShareToken[]
  codeGraph          CodeGraphSnapshot?

  @@index([userId])
  @@index([repoUrl])
  @@index([createdAt])
  @@index([repoOwner, repoName])
}

model ChatMessage {
  id          String   @id @default(cuid())
  analysisId  String
  role        String
  content     String
  createdAt   DateTime @default(now())

  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model FileSummary {
  id          String   @id @default(cuid())
  analysisId  String
  path        String
  language    String
  lines       Int      @default(0)
  complexity  Int      @default(0)
  description String   @default("")
  imports     String   @default("[]")
  exports     String   @default("[]")
  functions   String   @default("[]")
  classes     String   @default("[]")
  components  String   @default("[]")
  routes      String   @default("[]")
  issues      Int      @default(0)
  createdAt   DateTime @default(now())

  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([path])
}

// ==========================================
// CODE GRAPH SNAPSHOT (Phase 2 — symbol-level graph persistence)
// ==========================================
// One row per analysis. JSON-stringified CodeGraph (nodes + edges).
// Persisted once after parseRepository() runs in /api/analyze POST, then read
// by /api/codegraph/[analysisId] to avoid rebuilding on every request.

model CodeGraphSnapshot {
  id          String   @id @default(cuid())
  analysisId  String   @unique
  graph       String   // JSON-stringified CodeGraph
  nodeCount   Int
  edgeCount   Int
  truncated   Boolean  @default(false)
  createdAt   DateTime @default(now())

  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

// ==========================================
// USER SETTINGS (multi-tenant)
// ==========================================

model UserSettings {
  id          String   @id @default(cuid())
  userId      String?
  key         String
  value       String
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// ==========================================
// PROVIDER CREDENTIALS (server-side encrypted API keys)
// ==========================================

model ProviderCredential {
  id              String   @id @default(cuid())
  userId          String
  providerId      String   // openrouter | openai | anthropic | etc.
  label           String
  encryptedApiKey String   // AES-256 encrypted
  baseUrl         String
  model           String
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(4096)
  streaming       Boolean  @default(true)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, providerId, label])
}

// ==========================================
// USAGE TRACKING (quota enforcement)
// ==========================================

model UsageRecord {
  id          String   @id @default(cuid())
  userId      String
  type        String   // analysis | chat | agent_task
  month       String   // "2026-07" format
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month])
  @@unique([userId, type, month])
}

// ==========================================
// TOKEN USAGE RECORD (P3.1 — real monthly token budget enforcement)
// ==========================================
// One row per (user, month) holding the cumulative real token count consumed
// by ALL their AI calls (chat + analysis + agents + streaming). Incremented
// atomically on each callAI()/streamAI() via Prisma's `increment` operator.
// KEEP IN SYNC with prisma/schema.prisma — only the datasource provider differs.

model TokenUsageRecord {
  id          String   @id @default(cuid())
  userId      String
  month       String   // "2026-07" — same format as UsageRecord
  totalTokens Int      @default(0)
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  callCount   Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, month])
}

// ==========================================
// RATE LIMIT BUCKET (P3.3 — per-user, per-endpoint hourly rate limits)
// ==========================================
// One row per (user, endpoint, hour) holding the count of requests made
// against that endpoint within the given hour. Incremented atomically on
// each protected request via Prisma's `increment` operator — no read-then-
// write race, survives Vercel serverless cold-starts (in-memory limiters
// do NOT work on serverless — each invocation may be a fresh instance).
//
// `hour` is a string bucket key formatted "YYYY-MM-DD-HH" (local time, see
// getHourBucket() in src/lib/rate-limiter.ts). The bucket naturally rolls
// over at the top of each hour — first request of the new hour creates a
// fresh row with count=1. Old rows accumulate; a cleanup helper purges
// rows older than 24h opportunistically (no cron needed on Vercel).
//
// KEEP IN SYNC with prisma/schema.prisma — only the datasource provider differs.

model RateLimitBucket {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   // "analysis" | "chat" | "agent"
  hour      String   // "2024-01-15-14" (hour-precision bucket key)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, hour])
  @@index([userId, endpoint])
  @@index([hour])
}

// ==========================================
// AGENT MEMORY & EVENTS
// ==========================================

model MemoryEntry {
  id          String   @id @default(cuid())
  category    String
  key         String
  value       String   @default("{}")
  tags        String   @default("[]")
  repoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  accessCount Int      @default(0)

  @@index([category])
  @@index([repoUrl])
  @@index([key])
  @@unique([category, key, repoUrl])
}

model AgentTask {
  id          String   @id @default(cuid())
  taskId      String   @unique
  kind        String
  title       String
  status      String
  assignedAgent String?
  priority    String   @default("medium")
  input       String   @default("{}")
  output      String?
  error       String?
  progress    Int      @default(0)
  attempts    Int      @default(0)
  parentTaskId String?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status])
  @@index([kind])
  @@index([createdAt])
}

model AgentEvent {
  id          String   @id @default(cuid())
  taskId      String?
  agentId     String?
  type        String
  message     String
  level       String   @default("info")
  data        String?
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([agentId])
  @@index([createdAt])
}

// ==========================================
// SHARE TOKENS (public read-only analysis links)
// ==========================================

model ShareToken {
  id          String    @id @default(cuid())
  token       String    @unique
  analysisId  String
  createdBy   String
  expiresAt   DateTime?
  accessCount Int       @default(0)
  createdAt   DateTime  @default(now())

  analysis    Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([createdBy])
}

// ==========================================
// AUDIT LOG (admin actions)
// ==========================================

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String   // upgrade_user | downgrade_user | ban_user | unban_user | delete_user | impersonate
  targetId    String?
  details     String   @default("{}")
  createdAt   DateTime @default(now())

  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// PLATFORM AI CONFIG (admin-set, MULTI-PROVIDER)
// ==========================================

model PlatformAIConfig {
  id              String   @id @default(cuid())
  providerId      String   // openrouter | openai | anthropic | gemini | etc.
  encryptedApiKey String   // AES-256 encrypted
  baseUrl         String
  models          String   @default("[]") // JSON array of available models
  enabled         Boolean  @default(true)
  // P3.2: Admin-configured fallback chain. JSON array of
  //   [{ "providerId": "openai", "model": "gpt-4o-mini" }, ...]
  // Loaded by getFallbackChain() and iterated by callAIWithFallback()
  // when the primary provider returns 402/429/5xx/timeout. Optional.
  fallbackChain   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerId])  // one config per provider
  @@index([enabled])
}

// ==========================================
// AI CALL LOG (every AI provider call — redaction + cost telemetry)
// ==========================================
// Captures one row per callAI()/streamAI() invocation: which provider/model,
// how many tokens, latency, success/error, and how many secrets were redacted
// before the prompt left the system. userId is nullable because callAI() is
// the single chokepoint and doesn't always have user context (background jobs,
// system passes). API routes can call logAICall() directly to attach userId.

model AICallLog {
  id              String   @id @default(cuid())
  userId          String?  // null when called from background/system context
  analysisId      String?
  agent           String?  // "security" | "overview" | "chat" | "deep-analysis" | etc.
  passType        String?  // analysis pass name (architecture | security | ...)
  provider        String   // openai | anthropic | openrouter | gemini | azure | etc.
  model           String
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  latencyMs       Int?
  status          String   // "success" | "error" | "timeout"
  error           String?  // truncated error message (max ~500 chars)
  redactionCount  Int      @default(0)  // number of secrets stripped before send
  redactedLabels  String   @default("[]") // JSON array of secret types redacted
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([analysisId])
  @@index([provider, model])
  @@index([createdAt])
  @@index([status])
}

// ==========================================
// POLICY (P3.5 — admin-configured rules governing AI usage + analysis)
// ==========================================
// Admin-configured rules evaluated at API checkpoints (pre-analyze,
// pre-ai-call). Fixed catalog of 8 policy types — NO arbitrary eval
// (security: prevents code injection from admin-configured strings).
// `config` is a JSON blob whose schema depends on `type`; the evaluator
// in src/lib/policies/evaluator.ts dispatches on `type` and reads the
// expected keys. KEEP IN SYNC with prisma/schema.prisma — only the
// datasource provider differs.

model Policy {
  id        String   @id @default(cuid())
  type      String   // PolicyType enum — see POLICY_CATALOG in src/lib/policies/types.ts
  enabled   Boolean  @default(true)
  config    String   @default("{}")  // JSON, schema depends on `type`
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, enabled])
}
